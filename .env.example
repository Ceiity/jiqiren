# ======================= 奶龙云盘 环境变量 =======================
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 端口与数据 ----
# 对外端口（访问 http://服务器IP:HTTP_PORT）
HTTP_PORT=8080
# 监听地址：0.0.0.0 对外开放；如前面还有 Nginx/Caddy 做 HTTPS，可改为 127.0.0.1
BIND_ADDR=0.0.0.0
# 宿主机数据目录（数据库 / 文件 / 缓存 / 日志都在这里，升级重建容器不会丢失）
DATA_PATH=./data

# ---- 初始化 ----
# 首次启动、尚无管理员时需要的初始化令牌。留空则自动随机生成并打印在日志中：
#   docker compose logs api | grep "SETUP TOKEN"
SETUP_TOKEN=

# ---- 反向代理 / HTTPS ----
# 信任的代理层数：1 = 仅内置 nginx（默认）；2 = 内置 nginx 前面还有一层 HTTPS 反向代理
TRUST_PROXY=1
# Cookie 的 Secure 标记：auto（根据 HTTPS 自动判断）/ true / false
COOKIE_SECURE=auto
# 登录状态保持天数
SESSION_DAYS=30

# ---- 存储 ----
# local = 服务器本地磁盘（/data/storage）；s3 = S3 兼容对象存储
STORAGE_DRIVER=local
# 单个上传分片的最大值（MB），需 ≤ nginx client_max_body_size
MAX_CHUNK_MB=64
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=nailong
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---- 日志 ----
LOG_LEVEL=info
